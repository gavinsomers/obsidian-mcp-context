FROM apache/airflow:2.10.5-python3.12

USER root
WORKDIR /app

COPY pyproject.toml README.md CHANGELOG.md RELEASING.md ./
COPY obsidian_mcp_context ./obsidian_mcp_context
COPY dbt ./dbt
COPY models ./models
COPY dbt_project.yml ./
COPY airflow ./airflow

RUN chown -R airflow:0 /app
RUN mkdir -p /warehouse /seed-vault /live-vault \
    && chown -R airflow:0 /warehouse /seed-vault /live-vault

USER airflow

RUN python -m pip install --no-cache-dir -e ".[pipeline]"

ENV AIRFLOW_HOME=/opt/airflow
ENV AIRFLOW__CORE__LOAD_EXAMPLES=False
ENV AIRFLOW__CORE__DAGS_FOLDER=/app/airflow/dags
ENV AIRFLOW__CORE__EXECUTOR=SequentialExecutor
ENV AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
ENV AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////warehouse/airflow.db
